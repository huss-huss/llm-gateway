# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Required for the admin API and for hashing tenant API keys. Use long random values:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_ADMIN_KEY=change-me-admin-key
GATEWAY_KEY_PEPPER=change-me-pepper

# Storage (local dev defaults: SQLite + in-process fake Redis; docker-compose overrides these).
GATEWAY_DATABASE_URL=sqlite+aiosqlite:///./llm_gateway.db
GATEWAY_REDIS_URL=memory://

# Providers: leave a key empty to disable that provider (the router skips it).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_ENABLED=false
# OLLAMA_BASE_URL=http://localhost:11434

# Observability.
GATEWAY_LOG_LEVEL=INFO
GATEWAY_LOG_JSON=true
GATEWAY_OTEL_EXPORTER=none       # none | console | otlp
# GATEWAY_OTEL_ENDPOINT=http://localhost:4318
